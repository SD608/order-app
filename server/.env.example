PORT=4000
# Render Postgres를 사용할 때는 DATABASE_URL 하나만 설정해도 됩니다.
DATABASE_URL=
DB_SSL=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coffee_order_db
DB_USER=postgres
DB_PASSWORD=여기에_로컬_PostgreSQL_비밀번호
# 관리자 비밀번호는 16자 이상, 세션 서명 키는 32자 이상으로 설정하세요.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
NODE_ENV=development
